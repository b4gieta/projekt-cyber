@model projekt_cyber.ViewModels.RegisterViewModel

<h1>Rejestracja</h1>

<form asp-action="Register" method="post">
    <div asp-validation-summary="All"></div>

    <p>
        <label asp-for="UserName">Login</label><br>
        <input asp-for="UserName" autocomplete="username">
        <span asp-validation-for="UserName"></span>
    </p>

    <p>
        <label asp-for="Email">E-mail</label><br>
        <input asp-for="Email" type="email" autocomplete="email">
        <span asp-validation-for="Email"></span>
    </p>

    <p>
        <label asp-for="Password">Hasło</label><br>
        <input asp-for="Password" autocomplete="new-password">
        <span asp-validation-for="Password"></span>
    </p>

    <p>
        <label asp-for="ConfirmPassword">Powtórz hasło</label><br>
        <input asp-for="ConfirmPassword" autocomplete="new-password">
        <span asp-validation-for="ConfirmPassword"></span>
    </p>

    <button type="submit">Zarejestruj</button>
</form>

<p><a asp-action="Login">Mam już konto</a></p>