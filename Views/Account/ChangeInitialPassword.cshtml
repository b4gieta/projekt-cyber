@model projekt_cyber.ViewModels.ChangeInitialPasswordViewModel

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-4">
            <h1 class="h2 fw-bold mb-2">Ustaw nowe hasło</h1>
            <p class="text-secondary mb-0">
                To Twoje pierwsze logowanie. Zmień hasło jednorazowe, aby kontynuować.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form asp-action="ChangeInitialPassword" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">Nowe hasło</label>
                        <input asp-for="NewPassword" type="password" class="form-control"
                               autocomplete="new-password" placeholder="Wpisz nowe hasło" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Powtórz nowe hasło</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                               autocomplete="new-password" placeholder="Powtórz nowe hasło" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Ustaw nowe hasło
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
