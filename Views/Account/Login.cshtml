@model projekt_cyber.ViewModels.LoginViewModel
@using Microsoft.Extensions.Options
@using projekt_cyber.Services
@inject IOptions<RecaptchaSettings> Recaptcha

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="text-center mb-4">
            <h1 class="h2 fw-bold mb-2">Logowanie</h1>
            <p class="text-secondary mb-0">Zaloguj się na swoje konto.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">

                <form asp-action="Login" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
                        </div>
                    }

                    @if (ViewBag.LockoutSecondsLeft is int secondsLeft && secondsLeft > 0)
                    {
                        <div class="alert alert-warning mb-4" role="alert">
                            Pozostały czas blokady: <strong id="lockout-timer" data-seconds="@secondsLeft"></strong>
                        </div>
                    }

                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="mb-4">
                        <label asp-for="UserName" class="form-label fw-semibold">Login</label>
                        <input asp-for="UserName" class="form-control"
                               autocomplete="username" placeholder="Wpisz login" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold">Hasło</label>
                        <input asp-for="Password" type="password" class="form-control"
                               autocomplete="current-password" placeholder="Wpisz hasło" />
                    </div>

                    <div class="mb-4 d-flex justify-content-center">
                        <div class="g-recaptcha" data-sitekey="@Recaptcha.Value.SiteKey"></div>
                    </div>

                    <input type="text" style="position: absolute; left: -10000px" name="Website" tabindex="-1" autocomplete="off" />

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Zaloguj się
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script src="https://www.google.com/recaptcha/api.js?hl=pl" async defer></script>

<script>
    (function () {
        const el = document.getElementById('lockout-timer');
        if (!el) return;
        let s = parseInt(el.dataset.seconds, 10);
        const submit = document.querySelector('form button[type="submit"]');
        if (submit) submit.disabled = true;

        function tick() {
            if (s <= 0) {
                el.textContent = 'możesz spróbować ponownie';
                if (submit) submit.disabled = false;
                return;
            }
            const m = Math.floor(s / 60), r = s % 60;
            el.textContent = m + ':' + String(r).padStart(2, '0');
            s--;
            setTimeout(tick, 1000);
        }
        tick();
    })();
</script>