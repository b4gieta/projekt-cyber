@model projekt_cyber.ViewModels.ChangePasswordViewModel

<h1>Zmień hasło</h1>

<div asp-validation-summary="All"></div>

<form asp-action="ChangePassword" method="post">
    <div>
        <label asp-for="CurrentPassword">Aktualne hasło</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword"></span>
    </div>

    <div>
        <label asp-for="NewPassword">Nowe hasło</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="NewPassword"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword">Powtórz nowe hasło</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit">Zmień hasło</button>
</form>

<p><a asp-controller="Home" asp-action="Index">Powrót</a></p>