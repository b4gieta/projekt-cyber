
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - projekt_cyber</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/projekt_cyber.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    project_cyber
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Przełącz nawigację">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                Strona główna
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Privacy">
                                Prywatność
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 py-2 py-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-light small me-lg-2">
                                Zalogowano jako <strong>@User.Identity.Name</strong>
                            </span>

                            <a class="btn btn-outline-light btn-sm px-3"
                               asp-controller="Account" asp-action="ChangePassword">
                                Zmień hasło
                            </a>

                            @if (User.IsInRole("Administrator"))
                            {
                                <a class="btn btn-outline-info btn-sm px-3"
                                   asp-controller="Admin" asp-action="Index">
                                    Panel administratora
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button class="btn btn-danger btn-sm px-3 w-100" type="submit">
                                    Wyloguj
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-info btn-sm px-3 fw-semibold"
                               asp-controller="Account" asp-action="Login">
                                Zaloguj się
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-5">
        <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top bg-white mt-auto py-3">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span class="text-secondary small">
                &copy; 2026 projekt_cyber
            </span>
            <a class="link-secondary text-decoration-none small"
               asp-controller="Home" asp-action="Privacy">
                Polityka prywatności
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
