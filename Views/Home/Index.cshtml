@model IEnumerable<projekt_cyber.Models.Entry>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 fw-bold mb-1">Strona główna</h1>
        <p class="text-secondary mb-0">Przeglądaj i zarządzaj wpisami.</p>
    </div>

    @if (User.IsInRole("Redaktor") || User.IsInRole("Administrator"))
    {
        <a asp-controller="Entries" asp-action="Create" class="btn btn-primary">
            + Dodaj wpis
        </a>
    }
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="h5 fw-semibold mb-0">Wpisy</h2>
            <span class="badge bg-secondary">@Model.Count() wpisów</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 px-3">
            <h3 class="h5 text-secondary">Brak wpisów</h3>
            <p class="text-secondary mb-0">Nie dodano jeszcze żadnych wpisów.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-3" style="width: 20%;">Tytuł</th>
                        <th scope="col" style="width: 35%;">Treść</th>
                        <th scope="col" style="width: 15%;">Autor</th>
                        <th scope="col" style="width: 18%;">Data dodania</th>
                        @if (User.IsInRole("Redaktor") || User.IsInRole("Administrator"))
                        {
                            <th scope="col" class="text-end pe-3" style="width: 12%;">Akcje</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="text-truncate fw-semibold" style="max-width: 220px;" title="@entry.Title">
                                    @entry.Title
                                </div>
                            </td>
                            <td>
                                <div class="text-truncate text-secondary" style="max-width: 400px;" title="@entry.Content">
                                    @entry.Content
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary small text-truncate d-block" style="max-width: 150px;" title="@(entry.Author?.UserName ?? "Nieznany")">
                                    @(entry.Author?.UserName ?? "Nieznany")
                                </span>
                            </td>
                            <td>
                                <span class="text-secondary small text-nowrap">
                                    @entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </td>
                            @if (User.IsInRole("Redaktor") || User.IsInRole("Administrator"))
                            {
                                <td class="text-end pe-3">
                                    <form asp-controller="Entries" asp-action="Delete" method="post"
                                          onsubmit="return confirm('Czy na pewno chcesz usunąć ten wpis?');">
                                        <input type="hidden" name="id" value="@entry.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Usuń
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
