<h1>Strona główna</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <p>Zalogowano jako: @User.Identity.Name</p>

    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit">Wyloguj</button>
    </form>

    @if (User.IsInRole("Administrator"))
    {
        <p><a asp-controller="Admin" asp-action="Index">Panel administratora</a></p>
    }
}
else
{
    <p><a asp-controller="Account" asp-action="Login">Zaloguj</a></p>
}