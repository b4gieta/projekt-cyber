@model projekt_cyber.ViewModels.PasswordPolicyViewModel

<h1>Polityka haseł</h1>

@if (TempData["SuccessMessage"] != null)
{
    <p>@TempData["SuccessMessage"]</p>
}

<form asp-action="PasswordPolicy" method="post">
    <div>
        <input asp-for="RejectThreeRepeatedChars" />
        <label asp-for="RejectThreeRepeatedChars">
            Zabroń trzech identycznych znaków pod rząd
        </label>
    </div>

    <button type="submit">Zapisz ustawienia</button>
</form>

<p><a asp-action="Index">Powrót do panelu</a></p>