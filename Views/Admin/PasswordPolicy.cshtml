@model projekt_cyber.ViewModels.PasswordPolicyViewModel

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-4">
            <h1 class="h2 fw-bold mb-2">Polityka haseł</h1>
            <p class="text-secondary mb-0">
                Skonfiguruj zasady bezpieczeństwa i czas bezczynności sesji.
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form asp-action="PasswordPolicy" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
                        </div>
                    }

                    <div class="form-check form-switch mb-4">
                        <input asp-for="RejectThreeRepeatedChars" class="form-check-input" role="switch" />
                        <label asp-for="RejectThreeRepeatedChars" class="form-check-label fw-semibold">
                            Zabroń trzech identycznych znaków pod rząd
                        </label>
                        <div class="form-text">
                            Przykładowo hasło zawierające „aaa” lub „111” nie będzie dozwolone.
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="mb-4">
                        <label asp-for="IdleTimeoutMinutes" class="form-label fw-semibold">
                            Czas bezczynności przed wylogowaniem
                        </label>
                        <div class="input-group">
                            <input asp-for="IdleTimeoutMinutes" type="number" min="1" max="1440"
                                   class="form-control" />
                            <span class="input-group-text">min</span>
                        </div>
                        <div class="form-text">Dopuszczalny zakres: od 1 do 1440 minut.</div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Zapisz ustawienia
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
