@model projekt_cyber.ViewModels.CreatedUserViewModel

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h1 class="h3 fw-bold mb-2">Konto zostało utworzone</h1>
                    <p class="text-secondary mb-0">Nowe konto jest gotowe do przekazania użytkownikowi.</p>
                </div>

                <div class="bg-light rounded-3 p-3 mb-4">
                    <div class="mb-3">
                        <label class="form-label text-secondary small mb-1">Login</label>
                        <div class="fw-semibold">@Model.UserName</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small mb-1">Hasło jednorazowe</label>
                        <div class="fw-bold text-primary text-break">@Model.OneTimePassword</div>
                    </div>

                    <div>
                        <label class="form-label text-secondary small mb-1">Ważne do</label>
                        <div class="fw-semibold">@Model.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                </div>

                <div class="alert alert-warning mb-4" role="alert">
                    <strong>Ważne:</strong> przekaż hasło użytkownikowi w bezpieczny sposób.
                    Nie będzie ponownie wyświetlane w panelu administratora.
                </div>

                <div class="d-grid">
                    <a asp-action="Index" class="btn btn-primary">
                        Powrót do panelu administratora
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
