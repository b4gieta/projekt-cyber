@model projekt_cyber.ViewModels.EditUserViewModel

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-4">
            <h1 class="h2 fw-bold mb-2">Edytuj użytkownika</h1>
            <p class="text-secondary mb-0">Zaktualizuj dane konta użytkownika.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
                        </div>
                    }

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold">Nowy login</label>
                        <input asp-for="UserName" class="form-control" placeholder="Wpisz login" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">E-mail</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Wpisz adres e-mail" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Zapisz zmiany
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
